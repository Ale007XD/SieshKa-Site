# Database
POSTGRES_PASSWORD=change_me_in_production_use_strong_password

# Base URL (for links in Telegram)
BASE_URL=https://siesh-ka.ru

# Telegram (optional but recommended)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TG_MANAGER_CHAT_ID=your_manager_chat_id
TG_KITCHEN_CHAT_ID=your_kitchen_chat_id

# Menu schedule (Kirensk timezone)
TZ_NAME=Asia/Irkutsk
MORNING_START=07:00
MORNING_END=10:00
EVENING_START=15:00
EVENING_END=21:00

# Text for ASAP delivery
ASAP_TEXT=15–25 минут

# Environment (development/production)
ENV=production

# Backup settings
BACKUP_RETENTION_DAYS=7

# Admin Panel Credentials (for SQLAdmin login)
# Note: Basic Auth for /admin is configured via nginx/.htpasswd file
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# Logging
LOG_LEVEL=INFO
SQLALCHEMY_ECHO=false

# Redis settings
REDIS_URL=redis://redis:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
PHONE_RATE_LIMIT_PER_MINUTE=3

# Cache
MENU_CACHE_TTL=60

# Application
APP_NAME=Sieshka
DEBUG=false

# ============================================================================
# TIME-FIRST MENU SYSTEM (v4.0)
# ============================================================================

# Business timezone for all time calculations
BUSINESS_TZ=Asia/Ho_Chi_Minh

# Tomorrow ordering cutoff (HH:MM format)
TOMORROW_ORDER_CUTOFF=23:00

# Enable tomorrow orders feature
ENABLE_TOMORROW_ORDERS=true

# Default slot interval in minutes
SLOT_INTERVAL_MINUTES=15

# Base buffer for slot generation (minutes)
BASE_BUFFER_MINUTES=15

# Menu cache version (bump to invalidate all caches)
MENU_VERSION=1
